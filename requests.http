@baseUrl = http://localhost:8000/api/v1

POST {{baseUrl}}/notes
Content-Type: application/json

{
    "author":"Juan Diego",
    "content":"hola",
    "title":"Titulo"
}

### Invalid Create
POST {{baseUrl}}/notes
Content-Type: application/json

{
    "author":"Juan Diego",
    "content":"",
    "title":""
}

### Get All
GET {{baseUrl}}/notes
Content-Type: application/json

### Get by Id
GET {{baseUrl}}/notes/3
Content-Type: application/json


### Delete by Id
DELETE {{baseUrl}}/notes/1

### Update
PUT {{baseUrl}}/notes
Content-Type: application/json

{   "id":3,
    "author":"Juan Diego",
    "content":"Nota actualizada desde endpoint",
    "title":"Actualizada"
}